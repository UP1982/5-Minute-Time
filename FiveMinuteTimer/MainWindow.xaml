<Window x:Class="FiveMinuteTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="5 Minute Timer"
        Width="420"
        Height="220"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True">
    <!-- Transparent, topmost window allows the timer to float above other apps without blocking the view. -->
    <Window.Resources>
        <DropShadowEffect x:Key="DropShadowEffectResource"
                          BlurRadius="12"
                          ShadowDepth="0"
                          Direction="0"
                          Color="#AA000000" />
    </Window.Resources>
    <Grid>
        <Border x:Name="MainPanel"
                Background="#66000000"
                CornerRadius="24"
                Padding="24"
                Margin="32"
                MouseLeftButtonDown="MainPanel_MouseLeftButtonDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Grid.Row="0"
                            Margin="0,0,0,12">
                    <Button x:Name="StartButton"
                            Content="Start"
                            Margin="0,0,8,0"
                            Padding="8,4"
                            Click="StartButton_Click" />
                    <Button x:Name="StopButton"
                            Content="Stop"
                            Margin="0,0,8,0"
                            Padding="8,4"
                            Click="StopButton_Click" />
                    <Button x:Name="ResetButton"
                            Content="Reset"
                            Margin="0,0,8,0"
                            Padding="8,4"
                            Click="ResetButton_Click" />
                    <Button x:Name="CloseButton"
                            Content="✕"
                            Padding="8,4"
                            Click="CloseButton_Click" />
                </StackPanel>
                <Viewbox Grid.Row="1"
                         Stretch="Uniform"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         MouseLeftButtonDown="MainPanel_MouseLeftButtonDown">
                    <TextBlock x:Name="TimerText"
                               Text="05:00"
                               FontSize="72"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               Foreground="White"
                               Effect="{StaticResource DropShadowEffectResource}" />
                </Viewbox>
            </Grid>
        </Border>
        <Canvas x:Name="ConfettiCanvas"
                IsHitTestVisible="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
    </Grid>
</Window>
